#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: $0 <command-name>" >&2
  exit 2
fi

name="$1"
if ! [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]]; then
  echo "error: name must match ^[a-z][a-z0-9-]*$" >&2
  exit 2
fi

root="$(cd "$(dirname "$0")/.." && pwd)"
cmd_dir="$root/assets/commands/$name"
wrapper="$root/src/$name.tsx"

if [ -e "$cmd_dir" ]; then
  echo "error: $cmd_dir already exists" >&2
  exit 1
fi
if [ -e "$wrapper" ]; then
  echo "error: $wrapper already exists" >&2
  exit 1
fi

# Title-case for package.json: kebab → spaces, capitalize each word.
title="$(echo "$name" | awk -F- '{ for (i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2); print }' OFS=' ')"

mkdir -p "$cmd_dir"

cat > "$cmd_dir/source" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
# source contract: print newline-separated items to stdout, exit 0 on success.
# Any language is fine; this file just needs to be executable.
echo "hello"
echo "world"
EOF

cat > "$cmd_dir/sink" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
# sink contract: receive selected lines on stdin or argv, depending on sink_mode.
#   sink_mode "all":  one invocation, all selected lines joined by newlines.
#   sink_mode "each": one invocation per selected line as $1, in parallel.
cat
EOF

cat > "$cmd_dir/config.json" <<'EOF'
{
  "sink_mode": "all",
  "placeholder": "Filter…"
}
EOF

chmod +x "$cmd_dir/source" "$cmd_dir/sink"

cat > "$wrapper" <<EOF
import { Picker } from "./picker";
export default function Cmd() {
  return <Picker command="$name" />;
}
EOF

node -e '
  const fs = require("fs");
  const path = process.argv[1];
  const name = process.argv[2];
  const title = process.argv[3];
  const pkg = JSON.parse(fs.readFileSync(path, "utf8"));
  pkg.commands = pkg.commands || [];
  if (pkg.commands.some((c) => c.name === name)) {
    console.error("error: command " + name + " already in package.json");
    process.exit(1);
  }
  pkg.commands.push({
    name,
    title,
    description: title + " picker.",
    mode: "view",
  });
  fs.writeFileSync(path, JSON.stringify(pkg, null, 2) + "\n");
' "$root/package.json" "$name" "$title"

echo "created:"
echo "  assets/commands/$name/source"
echo "  assets/commands/$name/sink"
echo "  assets/commands/$name/config.json"
echo "  src/$name.tsx"
echo
echo "next: edit assets/commands/$name/source and assets/commands/$name/sink, then run"
echo "  npm run dev"
echo "(if dev is already running, it'll hot-reload)"
