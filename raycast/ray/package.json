{
  "name": "source-fzf-sink",
  "title": "Dynamic Picker",
  "description": "Generic Raycast pickers wired up from a pair of executables per command.",
  "icon": "command-icon.png",
  "author": "you",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "commands": [
    {
      "name": "eb-minutes",
      "title": "EB Minutes",
      "description": "View EB Minutes",
      "mode": "view"
    },
    {
      "name": "department-lists",
      "title": "Department Lists",
      "description": "Department Lists picker.",
      "mode": "view"
    },
    {
      "name": "building-lists",
      "title": "Building Lists",
      "description": "Building Lists picker.",
      "mode": "view"
    },
    {
      "name": "oc-meeting-notes",
      "title": "OC Meeting Notes",
      "description": "View OC Minutes",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "latest",
    "@raycast/utils": "latest"
  },
  "devDependencies": {
    "@raycast/eslint-config": "latest",
    "@types/node": "^22",
    "@types/react": "^18",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "^5"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "publish": "npx @raycast/api@latest publish"
  }
}
