#!/usr/bin/env bash
set -euo pipefail
# sink_mode "each": one invocation per selected line as $1.

base="$HOME/Google Drive/My Drive/GETUP-UAW Local 5124 Executive Board/Meeting Notes/EB Meetings"
selected="${1:?usage: sink <selected-title>}"

if [[ -e "$base/$selected" ]]; then
  open "$base/$selected"
  exit 0
fi

if [[ -e "$base/$selected.gdoc" ]]; then
  open "$base/$selected.gdoc"
  exit 0
fi

if [[ "$selected" =~ ^([0-9]{1,2})/([0-9]{1,2})/([0-9]{2,4})(.*)$ ]]; then
  file="${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}${BASH_REMATCH[4]}.gdoc"
  open "$base/$file"
  exit 0
fi

echo "could not find EB minutes document: $selected" >&2
exit 1
