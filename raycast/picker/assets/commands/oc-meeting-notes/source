#!/usr/bin/env bash
set -euo pipefail
shopt -s extglob
# source contract: print newline-separated items to stdout, exit 0 on success.

base="/Users/riley/Google Drive/My Drive/GETUP-UAW Organizing Committee/Organizing Committee Meetings/OC Meeting Notes"

ls -t "$base" | while IFS= read -r f; do
  name="${f%.gdoc}"
  printf '%s\n' "${name%%+([[:space:]])}"
done | awk '!seen[$0]++'
