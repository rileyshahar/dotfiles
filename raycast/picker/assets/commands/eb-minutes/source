#!/usr/bin/env bash
set -euo pipefail
# source contract: print newline-separated items to stdout, exit 0 on success.

base="$HOME/Google Drive/My Drive/GETUP-UAW Local 5124 Executive Board/Meeting Notes/EB Meetings"

ls -t "$base" | while IFS= read -r f; do
  name="${f%.gdoc}"

  if [[ "$name" =~ ^([0-9]{1,2})[[:space:]]+([0-9]{1,2})[[:space:]]+([0-9]{2,4})(.*)$ ]]; then
    printf '%s/%s/%s%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
  else
    printf '%s\n' "$name"
  fi
done
