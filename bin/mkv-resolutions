#!/usr/bin/env bash
# Report the resolution of every .mkv file in a directory.
# Usage: ./mkv-resolutions.sh [directory]   (defaults to current directory)

dir="${1:-.}"

if ! command -v ffprobe >/dev/null 2>&1; then
    echo "Error: ffprobe not found. Install ffmpeg first." >&2
    exit 1
fi

shopt -s nullglob nocaseglob
found=0

for f in "$dir"/*.mkv; do
    found=1
    res=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=width,height \
        -of csv=s=x:p=0 "$f")
    printf '%s\t%s\n' "${res:-unknown}" "$(basename "$f")"
done

if [ "$found" -eq 0 ]; then
    echo "No .mkv files found in '$dir'."
fi
